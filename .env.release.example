# Copy to .env.release (gitignored). This file contains nonsecret configuration only.
# Apple Developer Team ID (not the app's bundle ID).
LN_NOTARY_TEAM_ID=''

# Set up the profile once with: xcrun notarytool store-credentials lenotch
LN_NOTARY_KEYCHAIN_PROFILE='lenotch'

# Optional: SHA-1 fingerprint or exact name of a Developer ID Application identity
# on this team. If omitted, use the first valid identity on the team in Keychain.
# LN_SIGN_IDENTITY=''
