# Copy to .env.release (gitignored). Fill in the values within the quotes.
# Apple Developer account email and Apple Developer Team ID (not the bundle ID).
LN_NOTARY_APPLE_ID=''
LN_NOTARY_TEAM_ID=''
# Generate an app-specific password at https://account.apple.com/.
LN_NOTARY_PASSWORD=''

# Recommended alternative: store the Apple ID and password in the Keychain with
# xcrun notarytool store-credentials lenotch, then set this and leave the password blank.
# LN_NOTARY_KEYCHAIN_PROFILE='lenotch'

# Optional: SHA-1 fingerprint or exact name of a Developer ID Application identity
# on this team. If omitted, use the first valid identity on the team in Keychain.
# LN_SIGN_IDENTITY=''
