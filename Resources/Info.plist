<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key><string>LeNotch</string>
	<key>CFBundleDisplayName</key><string>LeNotch</string>
	<key>CFBundleIdentifier</key><string>com.lenotch.app</string>
	<key>CFBundleExecutable</key><string>LeNotch</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>1.1.2</string>
	<key>CFBundleVersion</key><string>9</string>
	<key>LSMinimumSystemVersion</key><string>15.0</string>
	<key>LSUIElement</key><true/>
	<key>NSHighResolutionCapable</key><true/>
	<key>NSPrincipalClass</key><string>NSApplication</string>
	<key>SUFeedURL</key><string>https://github.com/furkanksl/lenotch/releases/latest/download/appcast.xml</string>
	<!-- Add LeNotch's SUPublicEDKey before enabling Sparkle updates (tools/updates.sh). -->
	<key>SUEnableAutomaticChecks</key><true/>
	<key>NSCalendarsFullAccessUsageDescription</key><string>LeNotch shows your next meeting and its join link.</string>
	<key>NSBluetoothAlwaysUsageDescription</key><string>LeNotch shows your AirPods connecting and their battery.</string>
	<key>NSAudioCaptureUsageDescription</key><string>LeNotch moves the music bars with the sound your Mac plays. Nothing is recorded or saved.</string>
	<key>NSMicrophoneUsageDescription</key><string>LeNotch records your voice to transcribe dictation on your Mac. Audio is not sent to a server.</string>
	<key>NSAppleEventsUsageDescription</key><string>LeNotch controls Music and Spotify (play, pause, skip) when it can't read Now Playing directly.</string>
</dict>
</plist>
